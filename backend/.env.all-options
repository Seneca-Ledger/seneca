# Lumio Backend - Full Configuration Reference
# This file documents all available environment variables.
# You do not need all of these for local development.
# Minimal setup is documented in backend/.env.example.

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to make credentialed requests. Falls
# back to FRONTEND_URL. In production this is the whole allowlist — the
# localhost origins are only added outside production.
# CORS_ORIGINS=https://app.example.com
# Auth cookies. `lax` (the default) keeps the OAuth callback redirects working;
# use `none` — which forces Secure, so HTTPS only — when the frontend sits on a
# different registrable domain than the API.
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.example.com
# Signs password-reset tokens (HMAC). Falls back to JWT_SECRET.
# PASSWORD_RESET_TOKEN_SECRET=
# bcrypt work factor for new password hashes (10-15, default 12).
# BCRYPT_ROUNDS=12

# File storage (optional: override uploads directory, e.g. mounted volume in prod)
UPLOADS_DIR=

# Workspace backups. BACKUP_LOCAL_ROOT must be a dedicated writable directory;
# the app accepts only a relative folder name inside it. BACKUP_MASTER_KEY wraps
# per-workspace data keys and must be kept stable for scheduled backups.
BACKUP_LOCAL_ROOT=
BACKUP_MASTER_KEY=

# Database Configuration
DATABASE_URL=postgresql://lumio:lumio@localhost:5432/lumio

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration (for queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google APIs Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Google Drive OAuth (optional, falls back to GOOGLE_CLIENT_ID/SECRET)
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google-drive/callback
GOOGLE_DRIVE_STATE_SECRET=change-this-state-secret

# Gmail OAuth (optional, falls back to GOOGLE_CLIENT_ID/SECRET)
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/v1/integrations/gmail/callback
GMAIL_STATE_SECRET=change-this-state-secret

# Google Cloud Pub/Sub (for Gmail Watch API)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
PUBSUB_TOPIC_NAME=gmail-watch-notifications
PUBSUB_SUBSCRIPTION_NAME=gmail-watch-sub
PUBSUB_WEBHOOK_TOKEN=your-webhook-verification-token

# Dropbox OAuth
DROPBOX_CLIENT_ID=your-dropbox-app-key
DROPBOX_CLIENT_SECRET=your-dropbox-app-secret
DROPBOX_REDIRECT_URI=http://localhost:3001/api/v1/integrations/dropbox/callback
DROPBOX_STATE_SECRET=change-this-state-secret

# Token encryption (Google Drive, Dropbox + other integrations)
INTEGRATIONS_ENCRYPTION_KEY=change-this-32+char-key

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Resend (workspace invitations)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM="Lumio <noreply@your-domain.com>"
RESEND_REPLY_TO=

# Logging
LOG_LEVEL=info
SERVICE_NAME=lumio-backend
METRICS_AUTH_TOKEN=42758c3738cfb1b225f789027fdf19a14312e24f8703967da07070476efc3bb0

# Reliability / timeouts (optional)
STATEMENT_PARSING_CONCURRENCY=5
TELEGRAM_TIMEOUT_MS=10000
RESEND_TIMEOUT_MS=10000

# Receipt maps (optional, self-hosted only; unset disables the feature)
# Nominatim used to geocode merchant addresses printed on receipts
GEOCODER_URL=
GEOCODER_TIMEOUT_MS=3000
# tileserver-gl serving raster tiles; the backend proxies them to the browser
TILESERVER_URL=
TILESERVER_TIMEOUT_MS=5000
# Style id from the tile server's /styles.json used when a user has not picked one
MAP_DEFAULT_STYLE=

# Import Session Configuration
# Deduplication settings
DEDUP_DATE_TOLERANCE_DAYS=3
DEDUP_AMOUNT_TOLERANCE_PERCENT=2
DEDUP_TEXT_SIMILARITY_THRESHOLD=0.75
# Import workflow settings
IMPORT_AUTO_COMMIT=false
IMPORT_MAX_RETRIES=3
IMPORT_RETRY_BACKOFF_BASE_MS=30000
IMPORT_CONFLICT_AUTO_RESOLVE_THRESHOLD=0.95

# OpenRouter Configuration
OPENROUTER_API_KEY=

# Crypto wallets — Tron sync (optional; TronGrid answers without a key, a free key raises its rate limit)
TRONGRID_API_KEY=
# Crypto wallets — Solana sync (optional; the public RPC is used when empty, a private one avoids its rate limit)
SOLANA_RPC_URL=
