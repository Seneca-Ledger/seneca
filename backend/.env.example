# Stoic Budget backend environment variables
# Development mode is prepared by `npm run setup:dev` or `npm run setup:env`.
# Full reference: backend/.env.all-options

# Core settings (defaults shown):
# PORT=3001
# NODE_ENV=development
# FRONTEND_URL=http://localhost:3000
# APP_URL=http://localhost:3000
# APP_NAME="Stoic Budget"   # product name in e-mails, bot replies and files (root .env sets it for the whole stack)
# DATABASE_URL=postgresql://finflow:finflow@localhost:5434/finflow
# REDIS_URL=redis://localhost:6379

# Required in production only:
# JWT_SECRET=<run: openssl rand -base64 32>
# JWT_REFRESH_SECRET=<run: openssl rand -base64 32>
# INTEGRATIONS_ENCRYPTION_KEY=<run: openssl rand -base64 32>
# BACKUP_MASTER_KEY=<run: openssl rand -base64 32>
# BACKUP_LOCAL_ROOT=/var/lib/seneca/backups

# Required when Telegram webhook integration is enabled:
# TELEGRAM_WEBHOOK_SECRET=<run: openssl rand -base64 32>

# Optional auth settings:
# JWT_EXPIRES_IN=30m
# JWT_REFRESH_EXPIRES_IN=30d

# Optional logging:
# LOG_LEVEL=info
# SERVICE_NAME=seneca-backend

# Web push (mobile alerts). Generate once: npx web-push generate-vapid-keys
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:admin@example.com

# Sharing a taught statement layout with the project ("Help the project" after
# Teach): only headings, column positions, balance labels and the bank's name,
# sent at the user's request. false hides the offer. The URL defaults to the
# project's receiving service; empty means the user is offered an e-mail.
# PARSER_SUBMISSIONS_ENABLED=true
# PARSER_SUBMISSIONS_URL=
# PARSER_SUBMISSIONS_EMAIL=peterbaikov12@proton.me
