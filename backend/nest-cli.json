{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "config-assets/bank-profiles/**/*",
        "outDir": "dist"
      },
      {
        "include": "config-assets/brands/**/*",
        "outDir": "dist"
      }
    ]
  }
}
