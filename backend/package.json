{
  "name": "backend",
  "version": "1.0.0",
  "description": "Stoic Budget Backend - Bank statements processing system",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "build:scripts": "tsc -p tsconfig.scripts.json --outDir dist",
    "start": "node dist/main",
    "start:dev": "nodemon --watch src --watch scripts --ext ts,json,yaml --exec \"node --max-old-space-size=2048 -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npm run lint:check",
    "lint:check": "biome check --config-path=.. src/",
    "lint:fix": "biome check --config-path=.. --write src/",
    "format": "biome format --config-path=.. --write src/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project 'unit*'",
    "test:golden": "GOLDEN_ENABLED=1 vitest run --project golden",
    "golden:record": "ts-node -r tsconfig-paths/register scripts/record-golden.ts",
    "test:parsing": "vitest run --project 'unit*' @tests/unit/test/parsing-regression.spec.ts",
    "test:e2e": "vitest run --project e2e",
    "test:ci": "npm run test:ci:unit && npm run test:e2e",
    "test:ci:unit": "vitest run --project 'unit*' --no-file-parallelism --coverage",
    "test:watch": "vitest --project 'unit*'",
    "test:cov": "vitest run --project 'unit*' --coverage",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:run": "npm run build:scripts && node scripts/run-migrations-with-lock.js",
    "migration:run:dev": "ts-node --transpile-only -r tsconfig-paths/register scripts/run-migrations.ts",
    "migration:generate": "npm run typeorm migration:generate",
    "migration:revert": "npm run typeorm migration:revert",
    "create-admin": "npm run build:scripts && node dist/scripts/create-admin.js",
    "create-admin:dev": "ts-node --transpile-only -r tsconfig-paths/register scripts/create-admin.ts",
    "seed:demo": "npm run build:scripts && node dist/scripts/seed-demo.js",
    "seed:demo:dev": "ts-node --transpile-only -r tsconfig-paths/register scripts/seed-demo.ts",
    "recalc-tables:dev": "ts-node --transpile-only -r tsconfig-paths/register scripts/recalc-custom-tables.ts",
    "parse:debug": "ts-node -r tsconfig-paths/register scripts/parse-debug.ts",
    "parse:tables": "ts-node -r tsconfig-paths/register scripts/pdf-table-dump.ts",
    "parse:diff": "ts-node -r tsconfig-paths/register scripts/parse-diff.ts",
    "storage:verify": "ts-node -r tsconfig-paths/register scripts/storage-verify.ts",
    "storage:repair": "ts-node -r tsconfig-paths/register scripts/storage-verify.ts --repair",
    "cleanup:misdated-rates": "ts-node -r tsconfig-paths/register scripts/cleanup-misdated-rates.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.2.0",
    "@noble/hashes": "^2.4.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@scure/bip32": "^2.4.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.4.2",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "csv-parser": "^3.2.0",
    "docx": "^9.5.1",
    "dotenv": "^18.0.9",
    "effect": "4.0.6",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "franc": "^6.1.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.9.1",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.5.0",
    "mailparser": "^3.9.20",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.4",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.20",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "typeorm": "^1.1.2",
    "undici": "^7.30.1",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "webdav": "^5.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@effect/language-service": "0.87.4",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.20",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfmake": "^0.2.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "diff": "8.0.3",
    "nodemailer": "$nodemailer",
    "jws": "4.0.1",
    "jsonwebtoken": {
      "jws": "3.2.3"
    },
    "multer": "^2.5.0",
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1",
    "deepmerge-ts": "^8.0.1",
    "@react-email/components": {
      "@react-email/render": "$@react-email/render"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.4.2"
    },
    "typeorm": {
      "ioredis": "$ioredis"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "trustedDependencies": [
    "@swc/core",
    "bcrypt",
    "msgpackr-extract"
  ]
}
