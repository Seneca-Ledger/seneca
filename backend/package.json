{
  "name": "backend",
  "version": "1.0.0",
  "description": "Lumio Backend - Bank statements processing system",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "build:scripts": "tsc -p tsconfig.scripts.json --outDir dist",
    "start": "node dist/main",
    "start:dev": "nodemon --watch src --watch scripts --ext ts,json,yaml --exec \"node --max-old-space-size=2048 -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npm run lint:check",
    "lint:check": "biome check --config-path=.. src/",
    "lint:fix": "biome check --config-path=.. --write src/",
    "format": "biome format --config-path=.. --write src/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:golden": "GOLDEN_ENABLED=1 jest --config jest.unit.config.ts src/modules/parsing/__tests__/parsing.golden.spec.ts",
    "golden:record": "ts-node -r tsconfig-paths/register scripts/record-golden.ts",
    "test:parsing": "jest --config jest.unit.config.ts @tests/unit/test/parsing-regression.spec.ts",
    "test:e2e": "jest --config jest.e2e.config.ts --forceExit",
    "test:ci": "npm run test:unit -- --runInBand && npm run test:e2e",
    "test:watch": "jest --config jest.unit.config.ts --watch",
    "test:cov": "jest --config jest.unit.config.ts --coverage",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:run": "npm run build:scripts && node scripts/run-migrations-with-lock.js",
    "migration:run:dev": "ts-node --transpile-only -r tsconfig-paths/register scripts/run-migrations.ts",
    "migration:generate": "npm run typeorm migration:generate",
    "migration:revert": "npm run typeorm migration:revert",
    "create-admin": "npm run build:scripts && node dist/scripts/create-admin.js",
    "create-admin:dev": "ts-node --transpile-only -r tsconfig-paths/register scripts/create-admin.ts",
    "seed:demo": "npm run build:scripts && node dist/scripts/seed-demo.js",
    "seed:demo:dev": "ts-node --transpile-only -r tsconfig-paths/register scripts/seed-demo.ts",
    "recalc-tables:dev": "ts-node --transpile-only -r tsconfig-paths/register scripts/recalc-custom-tables.ts",
    "parse:debug": "ts-node -r tsconfig-paths/register scripts/parse-debug.ts",
    "parse:tables": "ts-node -r tsconfig-paths/register scripts/pdf-table-dump.ts",
    "parse:diff": "ts-node -r tsconfig-paths/register scripts/parse-diff.ts",
    "storage:verify": "ts-node -r tsconfig-paths/register scripts/storage-verify.ts",
    "storage:repair": "ts-node -r tsconfig-paths/register scripts/storage-verify.ts --repair",
    "cleanup:gmail-receipts": "ts-node -r tsconfig-paths/register scripts/cleanup-gmail-receipts.ts",
    "cleanup:misdated-rates": "ts-node -r tsconfig-paths/register scripts/cleanup-misdated-rates.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@huggingface/transformers": "^4.2.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.13",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.13",
    "@react-email/components": "^1.0.4",
    "@react-email/render": "^2.0.2",
    "@scure/bip32": "^1.7.0",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.2",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "csv-parser": "^3.2.0",
    "docx": "^9.5.1",
    "dotenv": "^16.6.1",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "franc": "^6.1.0",
    "helmet": "^8.3.0",
    "imapflow": "^1.7.1",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.1.0",
    "mailparser": "^3.9.20",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.13",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pdfmake": "^0.2.20",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^5.1.1",
    "typeorm": "^0.3.27",
    "undici": "^6.28.1",
    "web-push": "^3.6.7",
    "webdav": "^5.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "^2.5.13",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfmake": "^0.2.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-typescript-metadata": "^0.4.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "diff": "8.0.3",
    "jws": "4.0.1",
    "jsonwebtoken": {
      "jws": "3.2.3"
    },
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1",
    "deepmerge-ts": "^8.0.1",
    "@nestjs/swagger": {
      "js-yaml": "^5.4.2"
    }
  }
}
