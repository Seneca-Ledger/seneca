  "workspaces": {
    ".": {
      "entry": [
        "package.json"
      ],
      "project": [
        "*.{js,ts,json}"
      ]
    },
    "backend": {
      "entry": [
        "src/data-source.ts",
        "scripts/**/*.{ts,js}",
        "@tests/**/*.ts",
        "jest*.{js,ts}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,js}",
        "@tests/**/*.{ts,tsx}",
        "*.{js,ts}"
      ],
      "ignoreDependencies": [
        "swagger-ui-express"
      ]
    },
    "frontend": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "app/**/*.css",
        "next.config.*",
        "types/**/*.d.ts"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "types/**/*.{ts,tsx,d.ts}",
        "app/**/*.css",
        "*.{js,ts,mjs}"
      ],
      "postcss": {
        "config": [
          "postcss.config.mjs"
        ]
      },
      "tailwind": {
        "entry": [
          "app/**/*.css"
        ]
      }
    },
    "website": {
      "entry": [
        "src/**/*.{ts,tsx,js,jsx}",
        "docusaurus.config.*",
        "sidebars.*"
      ],
      "project": [
        "src/**/*.{ts,tsx,js,jsx}",
        "*.{js,ts,mjs,cjs}"
      ],
      "docusaurus": {
        "config": [
          "docusaurus.config.*",
          "sidebars.*"
        ]
      }
    }
  },
  "tags": [
    "-lintignore"
  ]
}
