{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "intlayer build && node scripts/build-locale-packs.mjs --if-present",
    "prebuild": "intlayer build && node scripts/build-locale-packs.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=12288 next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "npm run lint:check",
    "lint:check": "biome check --config-path=.. . && NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lint:fix": "biome check --config-path=.. --write . && NODE_OPTIONS=--max-old-space-size=8192 eslint --fix .",
    "lint:eslint": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lint:biome": "biome check --config-path=.. .",
    "format": "biome format --config-path=.. --write .",
    "type-check": "NODE_OPTIONS=--max-old-space-size=12288 tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:profile": "vitest run app/settings/profile/page.test.tsx",
    "audit:focus": "node scripts/focus-audit.mjs",
    "lint:css": "stylelint \"app/styles/**/*.scss\" \"app/components/**/*.scss\""
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "defu": "^6.1.7",
    "webpack-dev-server": "^5.2.6",
    "@ai-sdk/provider-utils": "^4.0.46",
    "zod": "$zod"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.5",
    "@mui/x-date-pickers": "^9.0.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.22",
    "@vitest/coverage-v8": "^4.1.12",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "driver.js": "^1.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "effect": "4.0.3",
    "framer-motion": "^12.34.3",
    "intlayer": "^9.7.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.3",
    "next-intlayer": "^9.7.0",
    "next-themes": "^0.2.1",
    "pdfjs-dist": "5.4.296",
    "pdfmake": "^0.2.23",
    "react": "19.2.9",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.9",
    "react-hot-toast": "^2.6.0",
    "react-intlayer": "^9.7.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "recharts": "3.10.1",
    "socket.io-client": "^4.8.3",
    "tinykeys": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@effect/language-service": "0.87.4",
    "@eslint/js": "^9.39.4",
    "@next/bundle-analyzer": "^16.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^24.0.0",
    "playwright-core": "^1.63.0",
    "react-scan": "^0.5.7",
    "sass": "^1.99.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18"
  }
}
