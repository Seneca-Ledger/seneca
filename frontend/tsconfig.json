{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@bank-logos": ["./app/bank-logos/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "types/**/*.d.ts", "**/*.mts", ".intlayer/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
