{
  "name": "parse-ledger",
  "version": "1.0.0",
  "description": "Seneca - Bank statements processing system",
  "main": "backend/dist/main.js",
  "scripts": {
    "prepare": "husky",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "start": "node backend/dist/main.js",
    "dev": "concurrently \"npm --prefix backend run start:dev\" \"npm --prefix frontend run dev\"",
    "setup:dev": "node scripts/setup-dev.mjs",
    "setup:dev:docker": "node scripts/setup-dev.mjs --docker",
    "setup:dev:local": "node scripts/setup-dev.mjs --local",
    "setup:dev:native": "node scripts/setup-dev.mjs --native",
    "setup:env": "node scripts/setup-dev.mjs --env-only",
    "test:setup-dev": "node --test scripts/setup-dev.test.mjs",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/sync-contracts.mjs --check",
    "test:sync-contracts": "node --test scripts/sync-contracts.test.mjs",
    "graphify:build": "node scripts/graphify-build.mjs",
    "graphify:validate": "node scripts/graphify-validate.mjs",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start",
    "i18n:check-locales": "node scripts/intlayer-locales-check.mjs",
    "backend:dev": "npm --prefix backend run start:dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:start": "npm --prefix frontend run start",
    "frontend:dev": "npm --prefix frontend run dev",
    "migration:run": "npm --prefix backend run migration:run",
    "migration:generate": "npm --prefix backend run migration:generate",
    "create-admin": "npm --prefix backend run create-admin",
    "knip": "knip",
    "test": "npm --prefix backend run test:unit && npm --prefix frontend run test",
    "test:backend": "npm --prefix backend run test:unit",
    "test:frontend": "npm --prefix frontend run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^25.9.9",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
