# Stoic Budget environment variables
# Development mode is prepared by `npm run setup:dev` or `npm run setup:env`.
# The generated .env file is ignored by git and can be edited locally.

# Product name everywhere people see it: UI and its translations, e-mails,
# Telegram replies and exported files made from now on.
# The backend reads it at startup; the frontend bakes it in when it is built, so
# restart the dev stack or rebuild the frontend image after changing it.
APP_NAME="Stoic Budget"

# Development defaults:
POSTGRES_USER=finflow
POSTGRES_PASSWORD=finflow
POSTGRES_DB=finflow
POSTGRES_PORT=5434
REDIS_PORT=6379
# Used by the cache and by the statement-parsing queue. When running the backend
# outside Docker, point this at the mapped host port (see REDIS_PORT).
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to make credentialed requests. Falls
# back to FRONTEND_URL. In production this is the whole allowlist — the
# localhost origins are only added outside production.
# CORS_ORIGINS=https://app.example.com
# Auth cookies. `lax` (the default) keeps the OAuth callback redirects working;
# use `none` — which forces Secure, so HTTPS only — when the frontend sits on a
# different registrable domain than the API.
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.example.com
# Which peers may set the client IP (X-Forwarded-For) that rate limits key on.
# Unset = one proxy hop. If the API port (BACKEND_PORT) is reachable from
# outside, a client talking to it directly can then pick its own IP; name the
# proxy's networks instead, e.g. `loopback, linklocal, uniquelocal` for a proxy
# on the same host or in the Docker network, or a hop count / CIDR list.
# TRUST_PROXY=1
# Signs password-reset tokens (HMAC). Falls back to JWT_SECRET.
# PASSWORD_RESET_TOKEN_SECRET=
# bcrypt work factor for new password hashes (10-15, default 12).
# BCRYPT_ROUNDS=12
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where "report an error" in the tax screens sends people. Leave it empty and
# the link is simply not rendered, rather than pointing somewhere that ignores it.
NEXT_PUBLIC_SUPPORT_EMAIL=peterbaikob12@proton.me

# Docker image tag used by docker-compose.yml when pulling prebuilt images
# (ghcr.io/stoic-budget/stoic-budget-backend and stoic-budget-frontend). Defaults to the newest release.
# IMAGE_TAG=v1.2.3

# Lets an instance admin install new releases from Settings -> Advanced. Starts the
# updater container, which controls Docker through its socket (root on the host).
# COMPOSE_PROFILES=updater

# Set to true to log every SQL query TypeORM runs (very noisy; off by default).
# DB_QUERY_LOGGING=true

# The day the demo workspace's twelve months of sample data end on (YYYY-MM-DD).
# Unset means today; the guide's screenshots pin it so they come out the same.
# DEMO_DATA_ANCHOR_DATE=2026-09-28

# Required in production; generated locally for development:
# JWT_SECRET=<run: openssl rand -base64 32>
# JWT_REFRESH_SECRET=<run: openssl rand -base64 32>
# Token lifetimes (defaults: access 30m, refresh 30d; refresh rotates on use):
# JWT_EXPIRES_IN=30m
# JWT_REFRESH_EXPIRES_IN=30d
# INTEGRATIONS_ENCRYPTION_KEY=<run: openssl rand -base64 32>
# BACKUP_MASTER_KEY=<run: openssl rand -base64 32>
# BACKUP_LOCAL_ROOT=/var/lib/seneca/backups


# Only for a Telegram webhook you set up by hand for TELEGRAM_BOT_TOKEN (POST /api/v1/telegram/webhook).
# Without it the server sets the webhook itself on an https APP_URL, or long-polls otherwise.
# TELEGRAM_WEBHOOK_SECRET=<run: openssl rand -base64 32>

# Receipt maps (optional, self-hosted only). Unset means the feature is off:
# receipts get no geocoded point and the map shows "not configured".
# Start the services with `docker compose --profile maps --profile geocoder up -d`.
# GEOCODER_URL=http://nominatim:8080
# TILESERVER_URL=http://tileserver:8080
# MAP_DEFAULT_STYLE=osm-bright
# OSM extract both services import on first start (Geofabrik region URL).
# MAP_PBF_URL=https://download.geofabrik.de/asia/kazakhstan-latest.osm.pbf

# User-managed integrations are configured in the UI:
# SMTP, S3-compatible storage, WebDAV, IMAP, Telegram, and App URL.
# Env integration values are supported only as temporary bootstrap/fallback defaults.
