# Statement uploads land in the backend's working directory when UPLOADS_DIR is
# unset, which is the default in local dev. Parsing fixtures are kept on purpose
# and live in backend/golden/ (anonymized) and docs/statements-examples/.
backend/*-statement.pdf
backend/*-receipt.pdf
# Real statements before anonymization (scripts/anonymize_statement_pdf.py).
backend/golden-private/

