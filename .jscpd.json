{
  "threshold": 5,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.content.ts",
    "**/*.spec.*",
    "**/*.test.*",
    "**/backend/src/contracts/**",
    "**/frontend/app/lib/contracts/**"
  ],
  "absolute": true,
  "gitignore": true,
  "minLines": 10,
  "minTokens": 50,
  "format": ["typescript", "javascript"]
}
